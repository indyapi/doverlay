# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ImgBB API Key
# สมัครฟรีที่ https://imgbb.com -> Account -> API
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# Admin Email (สร้างใน Firebase Auth > Email/Password)
NEXT_PUBLIC_ADMIN_EMAIL=admin@doverlay.local
